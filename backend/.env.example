# =============================================================================
# Clinical EDC — Backend Environment Template
# Copy this file to `.env` and fill in your values:  cp .env.example .env
# =============================================================================

# --- Core ---
APP_NAME=Clinical EDC
# One of: local | development | test | staging | production
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Database ---
# IMPORTANT: the app uses async SQLAlchemy, so the driver MUST be asyncpg.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/edc
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
ENVIRONMENT_NAMESPACE=local

# --- Security ---
# Generate a strong value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INACTIVITY_TIMEOUT_MINUTES=30

# --- Object storage (local filesystem by default) ---
OBJECT_STORAGE_BACKEND=local
OBJECT_STORAGE_LOCAL_DIR=attachments
OBJECT_STORAGE_NAMESPACE=local

# --- Optional: S3-compatible object storage ---
# OBJECT_STORAGE_BACKEND=s3
# S3_BUCKET_NAME=
# S3_REGION=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Optional: Redis ---
# REDIS_URL=redis://localhost:6379/0

# --- Feature flags ---
CTMS_ENABLED=true
CTMS_PHASE=1
PV_ENABLED=true
PV_PHASE=1

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false
