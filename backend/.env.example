# =============================================================================
# Clinical EDC — Environment Configuration Template
# Copy to .env and fill in values per-environment (Requirement 25.1)
# =============================================================================

# --- Core ---
ENVIRONMENT=local                # local | development | test | staging | production
DEBUG=true
APP_NAME="Clinical EDC"

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/edc
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Security ---
SECRET_KEY=CHANGE-ME-IN-PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
INACTIVITY_TIMEOUT_MINUTES=30

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=false

# --- Optional: AWS Cognito / OIDC ---
# COGNITO_USER_POOL_ID=
# COGNITO_REGION=
# COGNITO_APP_CLIENT_ID=

# --- Optional: Object Storage (S3) ---
# S3_BUCKET_NAME=
# S3_REGION=

# --- Optional: Redis (background jobs) ---
# REDIS_URL=redis://localhost:6379/0
