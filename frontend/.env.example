# Frontend environment configuration.
# Copy to `.env` (or `.env.local`) and adjust for your setup.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Base URL the app uses for API requests.
# Default (unset): "/api/v1" — relative, same-origin in production and proxied
# to the backend by the Vite dev server (see VITE_PROXY_TARGET below).
# Set to an absolute URL to talk to a remote backend directly, e.g.
#   VITE_API_BASE_URL=https://api.example.com/api/v1
# VITE_API_BASE_URL=/api/v1

# Backend the Vite dev server proxies `/api` requests to (development only).
# Only used when VITE_API_BASE_URL is left relative. Default: http://localhost:8000
# VITE_PROXY_TARGET=http://localhost:8000

# Backend OpenAPI schema URL used by `npm run api:refresh-schema` to pull a
# fresh spec for Orval code generation. Default: http://localhost:8000/api/v1/openapi.json
# VITE_OPENAPI_URL=http://localhost:8000/api/v1/openapi.json
